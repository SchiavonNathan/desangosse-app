# ==============================================================================
# Variáveis de Ambiente para Deploy (Docker)
# ==============================================================================

# Portas expostas no servidor Linux
FRONTEND_PORT=8081
BACKEND_PORT=3001

# URL que os navegadores usarão para chamar a API backend.
# Como configuramos um proxy no Nginx do frontend, você pode usar '/'
# para que as requisições usem a mesma porta 8080 do frontend automaticamente!
VITE_API_URL=/

# URL do frontend para cabeçalhos de segurança do backend
FRONTEND_URL=http://localhost

# Segredo JWT (Gere uma chave segura no Linux com: openssl rand -hex 48)
JWT_SECRET=super_secret_jwt_key_please_change_for_production_deployment_123456789

# Tempo de expiração do Token JWT
JWT_EXPIRES_IN=8h
